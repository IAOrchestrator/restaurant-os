# ===================================================
# RESTAURANT OS — PRODUCTION / ENVIRONMENT CONFIG
# ===================================================

# Database Connection (Supabase Transaction Pooler URL - Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection for Prisma Migrations (Supabase Direct - Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Backend API Configuration
PORT=3000
NODE_ENV="production"
JWT_SECRET="generate_a_secure_random_64_character_secret_key_here"

# Frontend / CORS
VITE_API_URL="https://your-restaurant-os-api.up.railway.app"
